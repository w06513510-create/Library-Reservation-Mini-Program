<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.dromara</groupId>
        <artifactId>ruoyi-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-pay</artifactId>

    <description>
        ruoyi-pay 支付/钱包基座：钱包对平引擎(三层余额+append-only流水+幂等+CAS防超扣+对平不变式) + 支付宝充值套件(下单/查单为准/通知验签/未配置降级模拟到账)，与 app_user 绑定，去业务耦合。
    </description>

    <dependencies>

        <!-- C端接入基座：提供 AppLoginHelper / app_user -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-app</artifactId>
        </dependency>

        <!-- 支付宝(沙箱)：自动装配 AlipayClient(@ConditionalOnProperty) + AlipayProperties -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-alipay</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-doc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-tenant</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-log</artifactId>
        </dependency>

    </dependencies>

</project>
